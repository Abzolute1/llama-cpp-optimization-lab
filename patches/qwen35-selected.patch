+// Process-local experiment; no backend/context struct layout changes.
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+static bool ggml_cuda_moe_staging_enabled() {
+    static const bool enabled = [] {
+        const char * value = getenv("GGML_CUDA_MOE_STAGING");
+        return value && strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+struct ggml_cuda_moe_stage_slot {
+    void * host = nullptr;
+    cudaEvent_t ready = nullptr;
+    bool pending = false;
+};
+
+struct ggml_cuda_moe_stage_state {
+    explicit ggml_cuda_moe_stage_state(int dev) : device(dev) {}
+    int device;
+    std::mutex mutex;
+    std::array<ggml_cuda_moe_stage_slot, 3> slots;
+    size_t chunk = 8 * 1024 * 1024;
+    size_t next = 0;
+    int n_slots = 2;
+    bool initialized = false, disabled = false, closed = false;
+    uint64_t calls = 0, bytes = 0, waits = 0;
+
+    void release() {
+        ggml_cuda_set_device(device);
+        for (auto & slot : slots) {
+            if (slot.pending) {
+                CUDA_CHECK(cudaEventSynchronize(slot.ready));
+                slot.pending = false;
+            }
+            if (slot.ready) {
+                CUDA_CHECK(cudaEventDestroy(slot.ready));
+                slot.ready = nullptr;
+            }
+            if (slot.host) {
+                CUDA_CHECK(cudaFreeHost(slot.host));
+                slot.host = nullptr;
+            }
+        }
+    }
+    ~ggml_cuda_moe_stage_state() { release(); }
+    bool initialize() {
+        if (initialized) return true;
+        if (disabled || closed) return false;
+        const char * chunk_env = getenv("GGML_CUDA_MOE_STAGING_CHUNK_MB");
+        const char * slots_env = getenv("GGML_CUDA_MOE_STAGING_SLOTS");
+        auto parse = [](const char * value, long fallback, long low, long high) {
+            if (!value) return fallback;
+            char * end = nullptr;
+            const long result = strtol(value, &end, 10);
+            return end != value && !*end && result >= low && result <= high ? result : -1L;
+        };
+        const long chunk_mb = parse(chunk_env, 8, 1, 64);
+        const long count = parse(slots_env, 2, 2, 3);
+        if (chunk_mb < 0 || count < 0) {
+            disabled = true;
+            GGML_LOG_WARN("MoE staging: invalid chunk/slot setting; original transfer path\n");
+            return false;
+        }
+        chunk = size_t(chunk_mb) * 1024 * 1024;
+        n_slots = int(count);
+        ggml_cuda_set_device(device);
+        for (int i = 0; i < n_slots; ++i) {
+            void * host = nullptr;
+            cudaError_t status = cudaMallocHost(&host, chunk);
+            if (status == cudaSuccess) {
+                slots[i].host = host;
+                cudaEvent_t event = nullptr;
+                status = cudaEventCreateWithFlags(&event, cudaEventDisableTiming);
+                if (status == cudaSuccess) slots[i].ready = event;
+            }
+            if (status != cudaSuccess) {
+                GGML_LOG_WARN("MoE staging: allocation failed (%s); original transfer path\n", cudaGetErrorString(status));
+                (void)cudaGetLastError();
+                release();
+                disabled = true;
+                return false;
+            }
+        }
+        initialized = true;
+        GGML_LOG_INFO("MoE staging: CUDA%d pinned ring %d x %zu bytes\n", device, n_slots, chunk);
+        return true;
+    }
+};
