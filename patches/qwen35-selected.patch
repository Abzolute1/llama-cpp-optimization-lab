+    }
+    if (src->type != GGML_TYPE_Q4_K && src->type != GGML_TYPE_Q5_K && src->type != GGML_TYPE_Q6_K) return false;
+    for (int i = 0; i < GGML_MAX_DIMS; ++i) {
+        if (src->ne[i] != dst->ne[i] || src->nb[i] != dst->nb[i]) return false;
+    }
+    if (offset > ggml_nbytes(src) || size > ggml_nbytes(src) - offset ||
+            offset > ggml_nbytes(dst) || size > ggml_nbytes(dst) - offset) return false;
+    auto * ctx = (ggml_backend_cuda_context *)backend->context;
+    if (dst->buffer->buft != ggml_backend_cuda_buffer_type(ctx->device)) return false;
