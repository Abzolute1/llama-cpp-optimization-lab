+    ggml_cuda_set_device(ctx->device);
+    const cudaStream_t stream = ctx->stream();
+    cudaStreamCaptureStatus capture;
+    CUDA_CHECK(cudaStreamIsCapturing(stream, &capture));
+    if (capture != cudaStreamCaptureStatusNone) return false;
