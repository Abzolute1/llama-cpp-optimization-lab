+struct ggml_cuda_moe_stage_registry {
+    std::mutex mutex;
+    std::map<ggml_backend_cuda_context *, std::shared_ptr<ggml_cuda_moe_stage_state>> contexts;
+};
+static ggml_cuda_moe_stage_registry & ggml_cuda_moe_stages() {
+    static auto * registry = new ggml_cuda_moe_stage_registry;
+    return *registry;
+}
+
+static void ggml_cuda_moe_stage_free(ggml_backend_cuda_context * ctx) {
+    if (!ggml_cuda_moe_staging_enabled()) return;
+    std::shared_ptr<ggml_cuda_moe_stage_state> state;
+    auto & registry = ggml_cuda_moe_stages();
+    {
+        std::lock_guard<std::mutex> lock(registry.mutex);
+        auto it = registry.contexts.find(ctx);
+        if (it == registry.contexts.end()) return;
+        state = std::move(it->second);
+        registry.contexts.erase(it);
+    }
+    if (!state) return;
+    std::lock_guard<std::mutex> lock(state->mutex);
+    state->closed = true;
+    state->release();
+    GGML_LOG_INFO("MoE staging: CUDA%d calls=%llu bytes=%llu slot-reuse-waits=%llu\n", ctx->device,
+                  (unsigned long long)state->calls, (unsigned long long)state->bytes, (unsigned long long)state->waits);
+}
